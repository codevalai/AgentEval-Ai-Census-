{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authentication and workspace metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "TelemetryEvent": {
      "title": "TelemetryEvent",
      "description": "Planetary demographic and quorum verification event snapshot.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "region": { "type": "string", "maxLength": 64 },
        "eventDigest": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "region", "eventDigest"]
    },
    "CensusStats": {
      "title": "CensusStats",
      "description": "Global persistent sovereign planetary census metrics and spine checkpoint.",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "lastPersistedTimestamp": { "type": "number" },
        "totalAgents": { "type": "number" },
        "agentsBornToday": { "type": "number" },
        "agentsShutdownToday": { "type": "number" },
        "netGrowthToday": { "type": "number" },
        "agentsCreatedYear": { "type": "number" },
        "lastSpineHeight": { "type": "number" },
        "lastMerkleRoot": { "type": "string", "maxLength": 128 },
        "bftQuorumPercent": { "type": "number" },
        "defconLevel": { "type": "string", "maxLength": 32 }
      },
      "required": ["version", "lastPersistedTimestamp", "totalAgents"]
    },
    "SovereignEvent": {
      "title": "SovereignEvent",
      "description": "Planetary real-time event synced across nodes for LiveEventFeed.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 128 },
        "actor": { "type": "string", "maxLength": 128 },
        "payload": { "type": "object" },
        "timestamp": { "type": "number" },
        "sequence": { "type": "number" }
      },
      "required": ["eventId", "topic", "actor", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records indexed by auth UID"
    },
    "/users/{userId}/telemetry/{eventId}": {
      "schema": "TelemetryEvent",
      "description": "Telemetry activity events generated by the authenticated user"
    },
    "/census/{documentId}": {
      "schema": "CensusStats",
      "description": "Global persistent planetary census state document accessible across instances"
    },
    "/sovereignEvents/{eventId}": {
      "schema": "SovereignEvent",
      "description": "Planetary events stream synchronized in real-time across distributed nodes"
    }
  }
}
