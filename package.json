{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/replay-verify.ts",
    "replay-verify": "tsx scripts/replay-verify.ts",
    "threat-verify": "tsx scripts/threat-radar-verify.ts",
    "governance-verify": "tsx scripts/governance-rfc-verify.ts",
    "intake-verify": "tsx scripts/verify-community-intake.ts",
    "telemetry-export": "tsx scripts/telemetry-sync-export.ts",
    "xerj:hub:list": "tsx scripts/xerj-hub-list.ts",
    "xerj:feedback": "tsx scripts/xerj-feedback.ts --open-pr",
    "trendshift:sweep": "tsx -e \"import { TrendshiftEcosystemHarvester } from './src/services/trendshiftEcosystemHarvester.ts'; (async () => { const h = new TrendshiftEcosystemHarvester(); const res = await h.fetchAndIngestEcosystem('daily', ['python', 'typescript']); console.log('Ecosystem Sweep Complete:', res); })();\"",
    "test:e2e": "tsx src/agents/__tests__/sovereign-e2e.test.ts",
    "verify:all": "tsc --noEmit && tsx scripts/verify-community-intake.ts && tsx src/agents/__tests__/sovereign-e2e.test.ts && tsx scripts/replay-verify.ts && tsx scripts/threat-radar-verify.ts && tsx scripts/governance-rfc-verify.ts && tsx scripts/telemetry-sync-export.ts"
  },
  "dependencies": {
    "@google/genai": "*",
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^11.8.1",
    "@tailwindcss/vite": "*",
    "@vis.gl/react-google-maps": "*",
    "@vitejs/plugin-react": "*",
    "dotenv": "*",
    "drizzle-kit": "*",
    "drizzle-orm": "*",
    "express": "*",
    "firebase": "*",
    "firebase-admin": "*",
    "lucide-react": "*",
    "motion": "*",
    "pg": "*",
    "react": "*",
    "react-dom": "*",
    "vite": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "*",
    "@types/node": "*",
    "@types/pg": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "autoprefixer": "*",
    "esbuild": "*",
    "tailwindcss": "*",
    "tsx": "*",
    "typescript": "*"
  }
}
